{
  "name": "kiosk",
  "version": "0.0.0",
  "private": true,
  "description": "CareFlow kiosk check-in UI (port 3000). Research prototype. Synthetic data only. Not for clinical use.",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 3000",
    "build": "NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "NEXT_TELEMETRY_DISABLED=1 next start --port 3000",
    "lint": "eslint .",
    "typecheck": "NEXT_TELEMETRY_DISABLED=1 next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "models:sync": "node scripts/models-sync.mjs"
  },
  "dependencies": {
    "@careflow/contracts": "workspace:*",
    "@careflow/laya-ts": "workspace:*",
    "@careflow/ui": "workspace:*",
    "next": "catalog:",
    "next-intl": "catalog:",
    "onnxruntime-web": "1.30.0",
    "qrcode.react": "4.2.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@tailwindcss/postcss": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "catalog:",
    "eslint-config-next": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
