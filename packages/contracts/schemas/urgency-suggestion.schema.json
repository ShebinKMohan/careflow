{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "UrgencySuggestion: see $defs/UrgencySuggestion. A model's suggested urgency level. Only a suggestion: the nurse confirms or overrides every level.",
  "$ref": "#/$defs/UrgencySuggestion",
  "$defs": {
    "UrgencyLevel": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "Urgency level. 1 = most urgent, 5 = least urgent, on every scale (KTAS, ESI, CTAS, MTS)."
    },
    "TriageScale": {
      "type": "string",
      "enum": [
        "KTAS",
        "ESI",
        "CTAS",
        "MTS"
      ],
      "description": "Triage scale the level is expressed in."
    },
    "SuggestionReason": {
      "type": "object",
      "description": "One of the top reasons for the suggestion, citing the facts it rests on.",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "fact_ids": {
          "type": "array",
          "items": {
            "$ref": "fact.schema.json#/$defs/FactId"
          },
          "uniqueItems": true,
          "maxItems": 20
        }
      },
      "required": [
        "text",
        "fact_ids"
      ],
      "additionalProperties": false
    },
    "UrgencySuggestion": {
      "title": "UrgencySuggestion",
      "description": "A model's suggested urgency level. Only a suggestion: the nurse confirms or overrides every level.",
      "type": "object",
      "properties": {
        "suggestion_id": {
          "$ref": "fact.schema.json#/$defs/Identifier"
        },
        "session_id": {
          "$ref": "fact.schema.json#/$defs/Identifier"
        },
        "level": {
          "$ref": "#/$defs/UrgencyLevel"
        },
        "scale": {
          "$ref": "#/$defs/TriageScale"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Calibrated probability that the level is correct."
        },
        "reasons": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SuggestionReason"
          },
          "minItems": 1,
          "maxItems": 3
        },
        "model_id": {
          "$ref": "fact.schema.json#/$defs/Identifier"
        },
        "model_version": {
          "$ref": "fact.schema.json#/$defs/Identifier"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "suggestion_id",
        "session_id",
        "level",
        "scale",
        "confidence",
        "reasons",
        "model_id",
        "model_version",
        "created_at"
      ],
      "additionalProperties": false
    }
  }
}
