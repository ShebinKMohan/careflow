      "linkId": "patient",
      "text": "About you",
      "type": "group",
      "item": [
        {
          "linkId": "patient.age_years",
          "text": "How old are you (or the patient), in years?",
          "type": "integer",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 150
            }
          ]
        },
        {
          "linkId": "patient.age_months",
          "text": "For a child under 5: how old, in months?",
          "type": "integer",
          "extension": [
            {
              "url": "http://hl7.org/fhir/StructureDefinition/minValue",
              "valueInteger": 0
            },
            {
              "url": "http://hl7.org/fhir/StructureDefinition/maxValue",
              "valueInteger": 60
            }
          ],
          "enableWhen": [
            {
              "question": "patient.age_years",
              "operator": "<",
              "answerInteger": 5
            }
