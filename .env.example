# CareFlow environment variables: NAMES ONLY, never values.
# Copy nothing by hand: run `uv run python scripts/gen_dev_env.py` to create the gitignored .env
# with random local dev secrets. Research prototype. Synthetic data only. Not for clinical use.

# --- Generated local dev secrets (scripts/gen_dev_env.py fills these) ---
CAREFLOW_JWT_SECRET=
CAREFLOW_DEV_PASSWORD=
CAREFLOW_DEV_DEVICE_SECRET=
CAREFLOW_WS_TICKET_SECRET=
CAREFLOW_HANDOVER_SIGNING_KEY=
CAREFLOW_WEBHOOK_SIGNING_SECRET=
CAREFLOW_AUDIT_HMAC_KEY=
CAREFLOW_FERNET_KEY=
CAREFLOW_PGCRYPTO_KEY=
POSTGRES_PASSWORD=
CAREFLOW_DB_APP_PASSWORD=
CAREFLOW_DB_MIGRATOR_PASSWORD=
HAPI_DB_PASSWORD=
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=
LANGFUSE_INIT_PROJECT_SECRET_KEY=
LANGFUSE_INIT_USER_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_CLICKHOUSE_PASSWORD=
LANGFUSE_MINIO_ROOT_PASSWORD=
LANGFUSE_REDIS_AUTH=

# --- Derived by scripts/gen_dev_env.py from the values above (M0-05) ---
DATABASE_URL=
DATABASE_URL_MIGRATOR=
REDIS_URL=
FHIR_BASE_URL=

# --- Optional vendor API keys (owner adds by hand; off when absent) ---
# With no key, tasks use the local (Qwen3.5-9B MLX) or replay provider and API-only rows are not_run.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPGRAM_API_KEY=
HF_TOKEN=

# --- Optional flags ---
# API background work, on unless set to 0: the queue's grace window (M1-10), the outbox relay and
# the live WebSocket fan-out (M1-11). Turn the relay off here when `careflow-api relay` runs it.
CAREFLOW_QUEUE_GRACE_TASK=
CAREFLOW_OUTBOX_RELAY=
CAREFLOW_LIVE_EVENTS=
# The event stream name and the WebSocket heartbeat (defaults: careflow:events, 20 s).
CAREFLOW_EVENT_STREAM=
CAREFLOW_WS_HEARTBEAT_S=
# Voice service (M1-14). It checks kiosk tokens with CAREFLOW_JWT_SECRET and posts turns to
# CAREFLOW_API_BASE_URL (default http://127.0.0.1:8000). The Plivo phone channel stays off unless
# VOICE_PLIVO_ENABLED=true (never set by the unattended run). VOICE_HOST/VOICE_PORT: 127.0.0.1:8090.
CAREFLOW_API_BASE_URL=
VOICE_PLIVO_ENABLED=
VOICE_HOST=
VOICE_PORT=
# Kiosk build flags: the mic button and the voice service's WebSocket URL. Left empty, the mic
# button is on when `make up` runs the voice service, and off otherwise; either way it shows only
# after the patient's saved voice consent (M2-05).
NEXT_PUBLIC_VOICE_ENABLED=
# The FHIR server the doctor's EHR links open (M1-17); default http://localhost:8080/fhir
NEXT_PUBLIC_FHIR_BASE_URL=
NEXT_PUBLIC_VOICE_WS_URL=
# Where the kiosk's QR hand-over sends the phone (M2-06); default http://localhost:3002.
NEXT_PUBLIC_COMPANION_URL=
# Set to 1 to run the live voice tests (pytest -m live) and VOICE_E2E=1 for the Playwright check.
CAREFLOW_LIVE_VOICE=
VOICE_E2E=
# Set to 1 only if you accept sending real KTAS rows to a hosted API (M3-03 frontier zero-shot row).
TRIAGE_ZERO_SHOT_API_ALLOWED=
# Explicit urgency model: hgb (default), or fine-tuned calibrated laya.
# Laya needs the local artifact and `uv sync --all-packages --extra laya`.
# Missing/invalid selected models produce no suggestion; no hidden model substitution.
TRIAGE_MODEL_KIND=
TRIAGE_MODEL_PATH=
TRIAGE_MODEL_DEVICE=cpu
TRIAGE_MODEL_THREADS=2

# Optional server-managed kiosk provisioning: removes device login from patient flows.
# Set explicitly for a provisioned station. The secret stays on the Next.js server.
CAREFLOW_KIOSK_AUTO_SETUP=
CAREFLOW_KIOSK_DEVICE_ID=
CAREFLOW_KIOSK_DEVICE_SECRET=

# Local startup verifies synthetic extraction before API readiness.
CAREFLOW_WARM_EXTRACTION=
# Experimental local extraction presentation; off by default after a live voice retry regression.
# Canonical output validation always applies. Recording and replay keep the full schema.
CAREFLOW_EXPERIMENTAL_COMPACT_EXTRACTION=0
# Optional local runtime override; unset LOCAL_LLM startup uses pinned 9B.
CAREFLOW_LLM_MODEL=
CAREFLOW_LLM_REVISION=
