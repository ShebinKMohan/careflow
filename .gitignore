# Secrets: never commit. .env.example (names only) is the committed template.
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.hypothesis/
*.egg-info/
build/
dist/

# Node / Next.js
node_modules/
.next/
out/
next-env.d.ts
coverage/
*.tsbuildinfo
.pnpm-store/
.vercel/

# Rust / Tauri
target/

# Data, models and private material (never committed)
services/triage/data/
services/triage/artifacts/
eval/private/
*.onnx.tmp
models/cache/
services/voice/models/

# Playwright
test-results/
playwright-report/
blob-report/

# OS / editors
.DS_Store
.idea/
.vscode/*
