# `make up` process state and logs (M1-19)
.run/
# The speech eval's TTS-voiced clips (M2-02): regenerated by eval/speech/make_clips.py.
eval/datasets/speech/clips/

# Local browser traces/reports can contain synthetic session credentials.
docs/evidence/**/browser-artifacts/
docs/evidence/**/browser-results.json
docs/evidence/**/voice-playwright.json
# Live welcome QR images contain signed, expiring entry capabilities; keep them local.
docs/evidence/ADAPTIVE-20260929/live/screenshots/*-welcome.png
docs/evidence/RECEPTION-20260928/screenshots/kiosk-welcome.png
docs/evidence/UI-REBUILD-20260928/screenshots/kiosk-welcome-desktop-live.png
docs/evidence/UI-REBUILD-20260928/screenshots/kiosk-welcome-live.png
.vercel
.env*
